{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "warehouse-prototype",
  "description": "出入库单四态改造与退库交互原型",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "cleanUrls": true
}
